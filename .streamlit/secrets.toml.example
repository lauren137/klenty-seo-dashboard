# Copy this to secrets.toml for local dev (or paste into Streamlit Cloud's "Secrets" tab).
# DO NOT commit secrets.toml — it's gitignored.

# Password to access the dashboard. Anyone with this can view your SEO data.
app_password = "change-me-to-something-strong"

[google_oauth]
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
refresh_token = "YOUR_REFRESH_TOKEN"
token_uri = "https://oauth2.googleapis.com/token"

[google_targets]
ga4_property_id = "264568011"
gsc_site_url = "sc-domain:klenty.com"
site_domain = "https://www.klenty.com"
